# =====================================================================
# PashuPoshan AI - Environment Variables Template (.env.example)
# =====================================================================
# Copy this file to .env.local for local development.
# NEVER commit your actual API keys (.env.local is already in .gitignore).
# For production, add these variables in your Vercel Project Settings.

# 1. NVIDIA NIM API Key (For Nemotron-3-Ultra-550B reasoning & NIM Vision)
NVIDIA_API_KEY=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

# Optional: Override default reasoning model (defaults to nvidia/nemotron-3-ultra-550b-a55b)
# NVIDIA_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# Optional: Select cloud vision provider ('gemini' or 'nvidia')
# VISION_PROVIDER=gemini

# 2. Google Gemini API Key (For Gemini 1.5 Flash Vision triage)
# GEMINI_API_KEY=your-gemini-api-key-here

# 3. Upstash Redis / Vercel KV (Optional: For distributed rate limiting & alerts)
# KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
# KV_REST_API_TOKEN=your-upstash-redis-bearer-token
